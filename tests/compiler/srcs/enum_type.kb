type NpcState: enum {
    IDLE,
    WALKING,
    RUNNING,
    RUNNING2,
    PATROLLING,
    DRINKING = 42,
    EATING,
};

var current_state: NpcState = NpcState.IDLE;
//var test: int = 32;
// TODO: deduce type of enums
var prev_state := NpcState.PATROLLING;

if current_state == NpcState.DRINKING {
    println("What you drinking there?");
} else if current_state == NpcState.EATING {
    println("Lunchtime, eh?");
} else {
    println("Nothing to report.");
}

if current_state == NpcState.IDLE && prev_state == NpcState.PATROLLING {
    println("Taking a wee break, sir.");
}
